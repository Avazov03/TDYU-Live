# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.e2e.staging.example

# local server secrets (never commit)
.secrets/

# deploy scripts with server credentials (local only)
scripts/deploy*.py
scripts/fix_deploy.py
scripts/upload_deploy_once.py
scripts/remove_open_tsul_server.py
scripts/install_ssl_watcher.py
scripts/upload_and_seed.py

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

/public/uploads/assignments/*
!/public/uploads/assignments/.gitkeep
/public/uploads/lessons/*
!/public/uploads/lessons/.gitkeep
/public/uploads/recordings/*
!/public/uploads/recordings/.gitkeep

# local zip extracts
.tmp-eski/
.eski-extract/

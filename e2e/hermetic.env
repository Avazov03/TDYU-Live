# Hermetic E2E environment (npm run test:e2e:full). Test-only values — no real secrets.
# Applied to the seed, `next build`, `next start` and Playwright. Local .env* files are NOT loaded.

# --- App -------------------------------------------------------------------
DATABASE_URL=postgresql://lexify:lexify@localhost:54329/lexify_e2e
AUTH_SECRET=hermetic-e2e-auth-secret-not-for-production-0123456789
AUTH_URL=http://localhost:3200
NEXTAUTH_URL=http://localhost:3200
NEXT_PUBLIC_APP_URL=http://localhost:3200
PORT=3200
# Not production-like: unlocks the fixture reset route and AI fake model.
LEXIFY_ENV=staging
E2E_FIXTURE_RESET_TOKEN=hermetic-e2e-fixture-reset-token-0123456789
ALLOW_RECORDING_E2E_HOOKS=1
AI_MENTOR_FAKE=1

FF_ENROLLMENT_ACCESS_MODE=enrollment
FF_COURSE_CHECKOUT_V2=true
FF_LIVE_WAITING_ROOM_V2=true
FF_LIVE_AV_POLICY_V2=true
FF_LIVE_ATTENDANCE_V3=true
FF_RECORDING_REVIEW_V1=true
FF_RECORDING_SIGNED_PLAYBACK_V1=true
FF_RECORDING_LEGACY_MIGRATION_V1=true
FF_AI_MENTOR_V1=1
FF_AI_MENTOR_AUDIENCE=all
FF_REFUNDS_V1=true
FF_COURSE_COMPLETION_V1=true

# Must stay off/empty: real external services and rules the fixtures do not satisfy.
FF_SCHEDULE_RULES_V1=false
FF_COURSE_REVIEW_V1=false
FF_LIVE_MUX_PLAYBACK_V1=false
FF_LIVE_SHARED_ROOMS=false
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=
MUX_WEBHOOK_SECRET=
GEMINI_API_KEY=
RESEND_API_KEY=
TELEGRAM_BOT_TOKEN=
# Alert path runs on every 500 but never reaches Telegram (no bot token).
OPS_ALERTS=1
OPS_ALERT_TELEGRAM_CHAT_IDS=e2e-ops-chat
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUDIT_ONLY=
RECORDING_MIGRATION_MODE=

# --- Playwright ------------------------------------------------------------
TEST_BASE_URL=http://localhost:3200
E2E_DB_READY=1
E2E_STUDENT_EMAIL=fixture.active1@lexify.local
E2E_STUDENT_PASSWORD=demo1234
E2E_TEACHER_EMAIL=fixture.teacher@lexify.local
E2E_TEACHER_PASSWORD=demo1234
E2E_ADMIN_EMAIL=staging.admin@lexify.local
E2E_ADMIN_PASSWORD=demo1234
E2E_COURSE_ID=a4444444-4444-4444-4444-444444444401
E2E_COURSE_TITLE=Fixture Course A
E2E_LESSON_ID=a5555555-5555-5555-5555-555555555501
E2E_LESSON_TITLE=Fixture ended lesson
E2E_CHECKOUT_V2_ENABLED=1
E2E_ENROLLMENT_AUTHORITATIVE=1
E2E_AI_FAKE=1
E2E_LIVE_WAVE1=1
E2E_LIVE_WAVE2=1
E2E_LIVE_WAVE3=1
E2E_RECORDING_WAVE1=1
E2E_RECORDING_WAVE2=1
E2E_RECORDING_WAVE3=1
# Mutating flows (e2e/flows) — need the hermetic seed, never run against staging.
E2E_FLOWS=1
# Needs real Mux credentials — staging/nightly only.
E2E_LIVE_MUX=

# =============================================================================
# Lexify — muhit o'zgaruvchilari (.env.example)
# Nusxalash: cp .env.example .env  (production'da server panel orqali to'ldiring)
# =============================================================================

# --- Majburiy (production) ---

# PostgreSQL ulanish satri
# Local (Docker): postgresql://opentsul:opentsul_dev@localhost:5432/opentsul?schema=public
# Neon/Supabase:  postgresql://user:pass@host:5432/opentsul?sslmode=require
DATABASE_URL="postgresql://opentsul:opentsul_dev@localhost:5432/opentsul?schema=public"

# NextAuth v5 — JWT imzolash (32+ tasodifiy belgi)
# Yaratish: openssl rand -base64 32
AUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"

# Ilova public URL (trailing slashsiz)
# Local:  http://localhost:3000
# Prod:   https://lexify.zonic.fit  (Open Tsul / open.okina.uz EMAS)
AUTH_URL="http://localhost:3000"

# Next.js / ba'zi hostinglar hali shuni ham o'qiydi (AUTH_URL bilan bir xil qiling)
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (ixtiyoriy — ikkalasi to'ldirilsa Google tugmasi ko'rinadi)
# Google Cloud Console → OAuth 2.0 Client → Authorized redirect URI:
#   http://localhost:3000/api/auth/callback/google
#   https://lexify.zonic.fit/api/auth/callback/google
# Consent "Testing" bo'lsa: Audience → Test users ga Gmail qo'shing.
# Hammaga ochish: Consent → Publish app (Production).
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Parolni tiklash emaili (Resend). Bo'sh bo'lsa production'da email yuborilmaydi.
# RESEND_API_KEY=""
# EMAIL_FROM="Lexify <noreply@lexify.zonic.fit>"

# --- Ixtiyoriy ---

# NODE_ENV=production   # serverda avtomatik o'rnatiladi

# Login, email va parolni ko'radigan super admin (vergul bilan bir nechta).
# Bo'sh qolsa: avazov@tdyu.live
# SUPER_ADMIN_EMAIL="avazov@tdyu.live"

# Seed faqat development/test uchun (production'da seed bloklanadi)
# ALLOW_SEED=true       # faqat mahalliy testda, ixtiyoriy

# Redis — kelajak bosqich (hozir kodda ishlatilmaydi)
# REDIS_URL="redis://localhost:6379"

# Prisma Dev (Docker'siz mahalliy Postgres)
# npx prisma dev   → DATABASE_URL avtomatik yoziladi

# Mux (jonli efir + VOD). Bo'sh bo'lsa demo rejim ishlaydi
# MUX_TOKEN_ID=""
# MUX_TOKEN_SECRET=""

# Bildirishnoma (ixtiyoriy)
# TELEGRAM_BOT_TOKEN=""
# RESEND_API_KEY=""
# EMAIL_FROM="Lexify <noreply@localhost>"

# --- Phase 1–2 feature flags (all default OFF = CURRENT behavior) ---
# See docs/architecture/PHASE1-FEATURE-FLAGS.md
# FF_ENROLLMENT_ACCESS_MODE=off
#   off        = legacy Subscription access only (default)
#   shadow     = serve legacy + log OLD vs NEW MATCH/MISMATCH (no UX change)
#   dual       = Enrollment when present; else legacy fallback
#   enrollment = Enrollment sole SoT (Phase 2.6 staging cutover) — no Subscription allow
# FF_ENROLLMENT_ACCESS=false
# FF_COURSE_CHECKOUT_V2=false
# FF_DISABLE_TARIFF_UI=false
# FF_DISABLE_ONBOARD_ENROLL=false
# FF_LIVE_WAITING_ROOM_V2=false
# FF_LIVE_SHARED_ROOMS=false
# FF_RECORDING_REVIEW_24H=false
# FF_REFUNDS_V1=false

# Cron (lesson reminders). Required for /api/cron/lesson-reminders
# CRON_SECRET=""
# TELEGRAM_WEBHOOK_SECRET=""

# --- Browser E2E (Playwright) — local/staging ONLY ---
# See docs/qa/BROWSER-E2E.md
# Never point TEST_BASE_URL at production (lexify.zonic.fit).
# Allowed staging: https://staging.lexify.zonic.fit
# TEST_BASE_URL=http://localhost:3000
# PLAYWRIGHT_BASE_URL=http://localhost:3000
# TEST_BASE_URL=https://staging.lexify.zonic.fit

# Role accounts (prefer dedicated E2E users; local seed defaults documented in BROWSER-E2E.md)
# E2E_STUDENT_EMAIL=
# E2E_STUDENT_PASSWORD=
# E2E_TEACHER_EMAIL=
# E2E_TEACHER_PASSWORD=
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=

# Optional deterministic course/lesson overrides (defaults = prisma/seed.ts IDs)
# E2E_COURSE_ID=44444444-4444-4444-4444-444444444401
# E2E_COURSE_TITLE=Fuqarolik huquqi: asoslar
# E2E_LESSON_ID=55555555-5555-5555-5555-555555555501
# E2E_LESSON_TITLE=Kirish: fuqarolik huquqi tizimi
# Staging Phase-2 fixtures: see .env.e2e.staging.example

# Future Checkout V2 browser tests (keep false; do not enable FF_COURSE_CHECKOUT_V2 from E2E)
# E2E_CHECKOUT_V2_ENABLED=false

# Set only when target DB schema matches Prisma + fixtures seeded (role/course smokes)
# E2E_DB_READY=false

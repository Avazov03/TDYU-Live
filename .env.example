# =============================================================================
# Lexify — muhit o'zgaruvchilari (.env.example)
# Nusxalash: cp .env.example .env  (production'da server panel orqali to'ldiring)
# =============================================================================

# --- Majburiy (production) ---

# PostgreSQL ulanish satri
# Local (Docker): postgresql://opentsul:opentsul_dev@localhost:5432/opentsul?schema=public
# Neon/Supabase:  postgresql://user:pass@host:5432/opentsul?sslmode=require
DATABASE_URL="postgresql://opentsul:opentsul_dev@localhost:5432/opentsul?schema=public"

# NextAuth v5 — JWT imzolash (32+ tasodifiy belgi)
# Yaratish: openssl rand -base64 32
AUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"

# Ilova public URL (trailing slashsiz)
# Local:  http://localhost:3000
# Prod:   https://lexify.zonic.fit  (Open Tsul / open.okina.uz EMAS)
AUTH_URL="http://localhost:3000"

# Next.js / ba'zi hostinglar hali shuni ham o'qiydi (AUTH_URL bilan bir xil qiling)
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (ixtiyoriy — ikkalasi to'ldirilsa Google tugmasi ko'rinadi)
# Google Cloud Console → OAuth 2.0 Client → Authorized redirect URI:
#   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Ixtiyoriy ---

# NODE_ENV=production   # serverda avtomatik o'rnatiladi

# Login, email va parolni ko'radigan super admin (vergul bilan bir nechta).
# Bo'sh qolsa: avazov@tdyu.live
# SUPER_ADMIN_EMAIL="avazov@tdyu.live"

# Seed faqat development/test uchun (production'da seed bloklanadi)
# ALLOW_SEED=true       # faqat mahalliy testda, ixtiyoriy

# Redis — kelajak bosqich (hozir kodda ishlatilmaydi)
# REDIS_URL="redis://localhost:6379"

# Prisma Dev (Docker'siz mahalliy Postgres)
# npx prisma dev   → DATABASE_URL avtomatik yoziladi

# Mux (jonli efir + VOD). Bo'sh bo'lsa demo rejim ishlaydi
# MUX_TOKEN_ID=""
# MUX_TOKEN_SECRET=""

# Bildirishnoma (ixtiyoriy)
# TELEGRAM_BOT_TOKEN=""
# RESEND_API_KEY=""
# EMAIL_FROM="Lexify <noreply@localhost>"
